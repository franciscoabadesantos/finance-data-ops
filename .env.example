# Required when publish is enabled.
#
# Left empty on purpose. The value named a `finance_ops` role and a `finance`
# database, neither of which exists — the roles are `finance_data_ops_worker`,
# `finance_feature_store_worker` and `finance`, and the only databases are
# `finance_feature_store` and `finance_prefect`. Anyone setting up from this
# file would have chased a connection error to a role that was never created.
#
# Production takes this from the Prefect Secret block, matching
# `finance-infra/secrets/data-ops-worker.env.template`, which also leaves it
# blank. For a local run, point it at the database holding `source_cache`.
DATA_OPS_DATABASE_URL=

# Optional manual/local source-refresh overrides. Scheduled production runs use ticker_registry.
DATA_OPS_SYMBOLS_OVERRIDE=

# Optional region-specific manual/local overrides for region-parameterized runs
DATA_OPS_SYMBOLS_OVERRIDE_US=
DATA_OPS_SYMBOLS_OVERRIDE_EU=
DATA_OPS_SYMBOLS_OVERRIDE_APAC=

# Optional runtime controls
DATA_OPS_LOOKBACK_DAYS=400
DATA_OPS_MAX_ATTEMPTS=3
DATA_OPS_SYMBOL_BATCH_SIZE=100
DATA_OPS_CACHE_ROOT=./data_cache

# FMP earnings shadow mode is disabled unless both values are set. Do not add
# the API key to logs, source control, or raw request_params.
FMP_API_KEY=
DATA_OPS_EARNINGS_PROVIDERS=yahoo_finance

# Corporate-actions shadow mode is manual-only and disabled unless this
# allowlist is set. Use `yahoo_finance` for validation only, or add `fmp` when
# FMP_API_KEY is deliberately available. Never put provider keys in reports.
DATA_OPS_CORPORATE_ACTION_PROVIDERS=

# Optional alert sink for critical failures (JSON POST webhook)
DATA_OPS_ALERT_WEBHOOK_URL=
